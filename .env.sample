# =============================================================================
# Общее
# =============================================================================
# Не загружать .env из файла (например, в CI) — true / не задано
# DISABLE_ENV_FILE=true
#
# Часть ключей ниже можно менять без рестарта через web-админку «Настройки бота»
# (/cabinet/admin/settings): значения сохраняются в bot_runtime_settings (миграция
# 000038) и перекрывают .env при старте и при PATCH.
# Только через .env (+ рестарт): токены провайдеров, MOYNALOG, LIFECYCLE_CRON,
# вкл/выкл способов оплаты.

# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_TOKEN=token
# Прокси для Telegram Bot API (http/https). Пример: http://user:pass@ip:3128
TELEGRAM_PROXY_URL=

# Публичная ссылка на Web App в кнопках подключения (true/false). URL задаётся в MINI_APP_URL
IS_WEB_APP_LINK=false
# URL Telegram Mini App (если пусто — не используется)
MINI_APP_URL=
# Картинка только для главного меню (greeting): HTTPS URL или путь к файлу (относительный к рабочей директории процесса или абсолютный).
# Примеры:
# GREETING_IMAGE=https://example.com/banner.jpg
# GREETING_IMAGE=./assets/greeting.jpg
GREETING_IMAGE=

# =============================================================================
# Режим продаж и цены (classic)
# =============================================================================
# classic — цены из переменных PRICE_* / STARS_PRICE_*
# tariffs — цены и лимиты из таблиц tariff / tariff_price (миграция 000008), PRICE_* остаются обязательными для валидации конфига
SALES_MODE=tariffs

# Цены подписки (руб.), обязательны даже при SALES_MODE=tariffs
PRICE_1=150
PRICE_3=400
PRICE_6=750
PRICE_12=1320

# На кнопках периодов 3 / 6 / 12 мес добавлять экономию в %: сравнение с «N × цена за 1 мес»
# (classic — PRICE_1; tariffs — amount_rub за 1 мес этого тарифа). true/false, по умолчанию false
SHOW_LONG_TERM_SAVINGS_PERCENT=true

# Цены в Telegram Stars (если TELEGRAM_STARS_ENABLED=true; по умолчанию берутся из PRICE_*)
STARS_PRICE_1=99
STARS_PRICE_3=280
STARS_PRICE_6=525
STARS_PRICE_12=925

# ₽ за 1 Telegram Star: админка/расчёт Stars; при LOYALTY_ENABLED — XP за оплату Stars ≈ звёзды × этот курс
RUB_PER_STAR=1.5

# =============================================================================
# База данных
# =============================================================================
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres?sslmode=disable

# Для docker-compose (если используете)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# =============================================================================
# Сервис
# =============================================================================
# Порт HTTP healthcheck (по умолчанию в коде 8080)
HEALTH_CHECK_PORT=3002

# Язык по умолчанию для сообщений бота (например ru, en)
DEFAULT_LANGUAGE=ru

# =============================================================================
# Remnawave
# =============================================================================
REMNAWAVE_URL=http://remnawave:3000
# remote | local (local — подставляются X-Forwarded-* для локального API)
REMNAWAVE_MODE=local
REMNAWAVE_TOKEN=token
# Доп. заголовки к API: пары Key:Value через точку с запятой
# REMNAWAVE_HEADERS=X-Custom: value;Other: value
# Webhook панели Remnawave (torrent blocker → увед клиенту в TG). Оба поля обязательны вместе.
# В панели: WEBHOOK_ENABLED=true, WEBHOOK_URL=https://<host>:<HEALTH_CHECK_PORT>/remnawave-webhook,
# WEBHOOK_SECRET_HEADER=<тот же секрет>. Подробности: documentation/notifications.md
REMNAWAVE_WEBHOOK_PATH=
REMNAWAVE_WEBHOOK_SECRET=

# =============================================================================
# Уведомления о платежах
# =============================================================================
# Уведомления о платежах в Telegram-группу (бот должен быть в группе с правом писать; для темы форума — message_thread_id).
PAYMENTS_NOTIFY_ENABLED=false
PAYMENTS_NOTIFY_CHAT_ID=-1001234567890
PAYMENTS_NOTIFY_MESSAGE_THREAD_ID=0
# События через запятую: paid (успешная оплата), cancel (отмена счёта). Пусто при включённых уведомлениях = оба.
PAYMENTS_NOTIFY_EVENTS=paid,cancel
# В текст paid: YooKassa / Platega — id и сумма из purchase (Platega — строка «Platega» + platega_id); Stars — доп. блок из SuccessfulPayment (если TELEGRAM_STARS_ENABLED); CryptoPay — доп. блок из ответа API (если CRYPTO_PAY_ENABLED).

# =============================================================================
# Оплата: CryptoPay
# =============================================================================
CRYPTO_PAY_ENABLED=true
CRYPTO_PAY_URL=https://pay.crypt.bot
CRYPTO_PAY_TOKEN=token

# =============================================================================
# Оплата: YooKassa
# =============================================================================
YOOKASA_ENABLED=true
YOOKASA_URL=https://api.yookassa.ru/v3
YOOKASA_SHOP_ID=id
YOOKASA_SECRET_KEY=key
YOOKASA_EMAIL=example@mail.com
# Необязательно: путь для mux (как TRIBUTE_WEBHOOK_URL). Если задан — подтверждение платежей YooKassa по вебхуку; если пусто — используется поллинг каждые 5 с.
# Здесь — ТОЛЬКО путь, без схемы и домена: YOOKASA_WEBHOOK_URL=/yookassa-hook
# В ЛК ЮKassa указывается уже полный URL: https://<ваш-домен>/yookassa-hook — reverse proxy
# должен прокидывать этот путь на HEALTH_CHECK_PORT. События в ЛК: payment.succeeded и payment.canceled.
# НЕ кладите сюда полный URL: он не даёт ошибки при старте, но вебхук всегда отвечает 404,
# а поллинг уже выключен непустым значением — оплаты перестанут подтверждаться вообще.
YOOKASA_WEBHOOK_URL=

# Прокси ТОЛЬКО для запросов к API ЮKassa (http/https/socks5, можно с логином:паролем).
# Нужен, если сеть до api.yookassa.ru нестабильна или блокируется — например,
# сервер вне РФ и часть TLS-соединений отваливается по таймауту.
# Пусто — прямое соединение. Глобальный HTTPS_PROXY использовать НЕЛЬЗЯ:
# он уведёт в прокси и обращения к панели Remnawave по внутреннему docker-DNS.
# YOOKASA_PROXY_URL=socks5://user:pass@host:1080
YOOKASA_PROXY_URL=

# =============================================================================
# Оплата: Platega (https://platega.io)
# =============================================================================
# Включите PLATEGA_ENABLED=true и хотя бы один метод ниже. MERCHANT_ID и SECRET обязательны при ENABLED.
PLATEGA_ENABLED=false
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Необязательно: вебхук Platega; пусто — поллинг статуса транзакций.
# Здесь — ТОЛЬКО путь, без схемы и домена: PLATEGA_WEBHOOK_URL=/platega-hook
# В кабинете Platega указывается уже полный URL: https://<ваш-домен>/platega-hook — reverse
# proxy должен прокидывать этот путь на HEALTH_CHECK_PORT и НЕ резать заголовки X-MerchantId
# и X-Secret: по ним хендлер авторизует запрос (сверка с PLATEGA_MERCHANT_ID / PLATEGA_SECRET).
# НЕ кладите сюда полный URL: он не даёт ошибки при старте, но вебхук всегда отвечает 404,
# а поллинг уже выключен непустым значением — оплаты перестанут подтверждаться вообще.
PLATEGA_WEBHOOK_URL=
PLATEGA_SBP_ENABLED=false
PLATEGA_CARDS_ENABLED=false
PLATEGA_ACQUIRING_ENABLED=false
PLATEGA_WORLDWIDE_ENABLED=false
PLATEGA_CRYPTO_ENABLED=false

# =============================================================================
# Оплата: Heleket (https://heleket.com) — в интерфейсе «Другая крипта»
# =============================================================================
# Криптоплатежи: монету и сеть выбирает плательщик на странице Heleket.
# Чеки в «Мой налог» по этим оплатам не отправляются (MOYNALOG_RECEIPT_FOR на них не влияет).
HELEKET_ENABLED=false
# ЛК Heleket → Настройки → API. Оба обязательны при HELEKET_ENABLED=true.
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
# Вебхук. В отличие от остальных касс Heleket не хранит адрес колбэка у себя —
# он уходит в каждом счёте, поэтому здесь удобнее ПОЛНЫЙ URL:
# HELEKET_WEBHOOK_URL=https://<ваш-домен>/heleket-hook
# Путь для mux берётся из этого же значения, reverse proxy должен прокидывать
# его на HEALTH_CHECK_PORT. Можно указать и голый путь (/heleket-hook) — тогда
# адрес колбэка склеится с CABINET_PUBLIC_URL; если кабинет выключен, колбэк не
# уйдёт и подтверждение останется на поллинге.
# Пусто — вебхука нет, оплаты подтверждает поллинг.
HELEKET_WEBHOOK_URL=
# Валюта номинала счёта. Меняйте, только если у мерчанта нет RUB: сумма НЕ
# конвертируется — рублёвое число просто выставят в другой валюте.
HELEKET_CURRENCY=RUB
# Префикс order_id счетов. ОБЯЗАТЕЛЬНО задайте разный на боевом и тестовом
# стенде, если они ходят в один и тот же мерчант Heleket: иначе счёт одного
# стенда может быть зачтён другому (order_id уникален в пределах мерчанта).
HELEKET_ORDER_PREFIX=shop
# Сколько живёт счёт, секунды (Heleket принимает 300…43200).
HELEKET_INVOICE_LIFETIME=3600

# =============================================================================
# Оплата: Telegram Stars
# =============================================================================
TELEGRAM_STARS_ENABLED=true
# Требовать успешную оплату картой/криптой до оплаты Stars (true/false)
REQUIRE_PAID_PURCHASE_FOR_STARS=false

# =============================================================================
# Tribute (если задан TRIBUTE_WEBHOOK_URL — остальные обязательны)
# =============================================================================
TRIBUTE_WEBHOOK_URL=
TRIBUTE_API_KEY=
TRIBUTE_PAYMENT_URL=

# =============================================================================
# Мой налог (доход после успешной оплаты; см. MOYNALOG_RECEIPT_FOR)
# =============================================================================
MOYNALOG_ENABLED=false
# По умолчанию в коде: https://lknpd.nalog.ru/api/v1 
MOYNALOG_URL=https://lknpd.nalog.ru/api/v1 
MOYNALOG_USERNAME=
MOYNALOG_PASSWORD=
MOYNALOG_PROXY_URL=
# Какие способы оплаты отправляют доход в API «Мой налог»: через запятую — yookassa, platega, crypto (токен crypto = CryptoPay в ₽; текст дохода без упоминания криптовалюты, см. readme).
# Не задано = yookassa + platega. Пустая строка = ни один способ.
MOYNALOG_RECEIPT_FOR=yookassa
# Чек пишется в БД до отправки и переотправляется, если ФНС недоступна или
# протухла авторизация. Расписание воркера повторов (cron, по умолчанию раз в 10 мин).
MOYNALOG_RETRY_CRON=*/10 * * * *
# Сколько часов повторять чек, считая от времени ОПЛАТЫ. Простой ФНС измеряется
# днями, поэтому запас большой: по истечении срока чек снимается с повторов и
# приходит уведомление — такой доход придётся внести в приложении вручную.
MOYNALOG_RETRY_MAX_AGE_HOURS=720

# =============================================================================
# Трафик и лимиты
# =============================================================================
# Лимит трафика в ГБ (0 = по смыслу конфигурации Remnawave/панели)
TRAFFIC_LIMIT=0
# Стратегия сброса трафика для платных подписок: day | week | month | month_rolling | never
# month — календарный месяц (1-е число); month_rolling — скользящий месяц от даты создания пользователя в панели (Remnawave MONTH_ROLLING)
TRAFFIC_LIMIT_RESET_STRATEGY=month

# =============================================================================
# Пробный период
# =============================================================================
TRIAL_DAYS=14
TRIAL_TRAFFIC_LIMIT=3
# day | week | month | month_rolling | never (если пусто в коде — month)
TRIAL_TRAFFIC_LIMIT_RESET_STRATEGY=month
# Учитывать дни триала при первой оплате (true/false)
TRIAL_ADD_TO_PAID=false


# =============================================================================
# ТЭГИ В remnawave 
# =============================================================================
# Тег пользователей в Remnawave (формат: ^[A-Z0-9_]+$)
REMNAWAVE_TAG=TG_TAG
# Тег для trial (формат ^[A-Z0-9_]+$); пусто — как REMNAWAVE_TAG
TRIAL_REMNAWAVE_TAG=TRIAL_TAG


# =============================================================================
# HWID / доп. устройства
# =============================================================================
# Продажа доп. HWID-слотов: кнопки «добавить устройство», продление extra вместе с подпиской, отдельная оплата HWID. true = как раньше; false = выкл (уже выданные слоты не трогаются). По умолчанию в коде true, если переменная не задана.
HWID_EXTRA_DEVICES_ENABLED=true
HWID_ADD_PRICE=75
HWID_ADD_STARS_PRICE=50
HWID_MAX_DEVICE=10
TRIAL_HWID_LIMIT=1
# 0 = использовать HWID_FALLBACK_DEVICE_LIMIT как базу для классического режима
PAID_HWID_LIMIT=0
HWID_FALLBACK_DEVICE_LIMIT=2

# =============================================================================
# Реферальная система
# =============================================================================
# default | progressive
REFERRAL_MODE=progressive
REFERRAL_DAYS=14
REFERRAL_FIRST_REFERRER_DAYS=7
REFERRAL_FIRST_REFEREE_DAYS=7
REFERRAL_REPEAT_REFERRER_DAYS=3
# Начислять пригласившему помесячно (только REFERRAL_MODE=progressive).
#
# Включено: за первую оплату реферала пригласивший получает
# REFERRAL_FIRST_REFERRER_DAYS за первый оплаченный месяц плюс
# REFERRAL_REPEAT_REFERRER_DAYS за каждый следующий; за все последующие оплаты —
# REFERRAL_REPEAT_REFERRER_DAYS за каждый оплаченный месяц.
# При 7 и 3: первая оплата на 1 мес — 7 дн., на 6 мес — 7+3*5=22 дн.,
# на 12 мес — 7+3*11=40 дн.; повторная на 12 мес — 3*12=36 дн.
#
# Приглашённый получает REFERRAL_FIRST_REFEREE_DAYS один раз, и эта величина от
# срока не зависит: это приветственный бонус за приход по ссылке, а не доля чека.
#
# false — прежнее поведение: фиксированный бонус независимо от срока.
REFERRAL_SCALE_BY_MONTHS=true

# =============================================================================
# Партнёрская программа
# =============================================================================
# Не путать с реферальной. Реферальная платит днями подписки всем клиентам,
# партнёрская — деньгами отдельным людям: у партнёра есть баланс, холд и заявки
# на вывод. Клиент попадает ровно в одну из программ: пришедший по партнёрской
# ссылке рефералом не становится.
#
# Все переменные ниже редактируются из админки без перезапуска бота.
# Подробности: documentation/partner-program.md

# Общий рубильник. false — раздел скрыт, начисления не идут; начисленное остаётся
PARTNER_PROGRAM_ENABLED=false
# Показывать клиентам форму заявки на партнёрство
PARTNER_APPLICATIONS_ENABLED=true
# Принимать в партнёры без модерации
PARTNER_AUTO_APPROVE=false
# Процент с первой оплаты приведённого клиента
PARTNER_FIRST_PERCENT=40
# Процент со всех последующих оплат. Оба процента — значения по умолчанию:
# у партнёра могут быть индивидуальные условия, они перекрывают эти.
PARTNER_RENEWAL_PERCENT=20
# Сколько дней начисление недоступно к выводу; 0 — доступно сразу
PARTNER_HOLD_DAYS=7
# Минимальная сумма заявки на вывод, ₽
PARTNER_MIN_PAYOUT=1000
# Минимальный интервал между заявками на вывод, дней
PARTNER_PAYOUT_COOLDOWN_DAYS=7
# Сколько рабочих потоков может завести партнёр (архивные лимит не занимают)
PARTNER_MAX_LINKS=10
# Начислять ли процент с доплаты за дополнительные устройства
PARTNER_COUNT_EXTRA_HWID=false

# Уведомления в Telegram. Только транзакционные: вам — заявка и запрос на вывод,
# партнёру — решение по его заявке и по его выводу. Начисления не шлём.
PARTNER_NOTIFY_ENABLED=true
# Куда слать вашу половину. Пусто или 0 — в личку ADMIN_TELEGRAM_ID.
# Группа: -1001234567890 (бот должен быть в ней администратором)
PARTNER_NOTIFY_CHAT_ID=
# Тема форума внутри группы; 0 — основной чат
PARTNER_NOTIFY_MESSAGE_THREAD_ID=0

# =============================================================================
# Лояльность. 1руб = 1xp лояльности
# =============================================================================
# false — UI и начисления отключены, loyalty_xp в БД не трогаем
LOYALTY_ENABLED=false
# Потолок суммарной скидки: лояльность % + промо % (1–100, по умолчанию 100)
LOYALTY_MAX_TOTAL_DISCOUNT_PERCENT=50
# Минимум XP за успешную оплату, если сумма в ₽/Stars не дала баллов (0 = выкл.). Для Stars задайте RUB_PER_STAR — XP = звёзды × курс.
LOYALTY_XP_MIN_PER_PURCHASE=0

# =============================================================================
# Squads Remnawave (UUID через запятую)
# =============================================================================
# Пусто — подставляются все internal squads с панели
SQUAD_UUIDS=
EXTERNAL_SQUAD_UUID=

TRIAL_INTERNAL_SQUADS=
TRIAL_EXTERNAL_SQUAD_UUID=

# =============================================================================
# Календарь подписки
# =============================================================================
DAYS_IN_MONTH=30

# =============================================================================
# Админ и доступ
# =============================================================================
ADMIN_TELEGRAM_ID=123123123
# Пересылать админу сообщения пользователей и неизвестные команды (true/false)
FORWARD_USER_MESSAGES_TO_ADMIN=true

BLOCKED_TELEGRAM_IDS=
WHITELISTED_TELEGRAM_IDS=

# =============================================================================
# Опциональные URL для кнопок (пусто — кнопка скрыта)
# =============================================================================
SERVER_STATUS_URL=https://example.com/status
SUPPORT_URL=https://example.com/support
# Кабинетный чат поддержки (bridge к telegram-support-bot). По умолчанию false — кнопка «Поддержка» в кабинете ведёт на SUPPORT_URL.
# При true: SPA-чат, API /cabinet/api/support/*, webhook /cabinet/api/internal/support/webhook; нужна миграция 000036_cabinet_support.
# Настройка support-bot (SHOP_WEBHOOK_URL и т.д.) — в репозитории telegram-support-bot; гайд: documentation/cabinet/SETUP-GUIDE-RU.md
SUPPORT_BOT_API=false
# Базовый URL HTTP sidecar support-bot (POST /internal/cabinet/message). В Docker — имя сервиса, не localhost.
# SUPPORT_BOT_API_URL=http://support-bot:8080
# Общий секрет с support-bot (Bearer). Должен совпадать с SUPPORT_BRIDGE_SECRET в .env support-bot.
# SUPPORT_BRIDGE_SECRET=change-me-shared-secret
# Аватар поддержки в чате кабинета 
# Можно указать тот же файл, что и CABINET_BRAND_LOGO_FILE (например ./vpn_cat.png)
# SUPPORT_LOGO_FILE=./vpn_cat.png
# URL кнопки «Отзывы» в боте (classic — всегда при непустом URL; minimalism — при CABINET_TELEGRAM_SHOW_FEEDBACK_BUTTON=true).
# Можно менять в админке (Ссылки в боте).
FEEDBACK_URL=https://example.com/feedback

# =============================================================================
# Lifecycle-уведомления 
# =============================================================================
LIFECYCLE_NOTIFY_ENABLED=true
LIFECYCLE_CRON=*/30 * * * *

# Не подключился после первой оплаты/триала
LIFECYCLE_NO_CONNECT_PAID_ENABLED=true
LIFECYCLE_NO_CONNECT_TRIAL_ENABLED=true
LIFECYCLE_NO_CONNECT_DELAY_HOURS=1
LIFECYCLE_NO_CONNECT_MAX_AGE_HOURS=24

# Win-back после просрочки
LIFECYCLE_WINBACK_ENABLED=true
LIFECYCLE_WINBACK_DAYS_AFTER_EXPIRY=3
LIFECYCLE_WINBACK_DISCOUNT_PERCENT=10
LIFECYCLE_WINBACK_DISCOUNT_TTL_HOURS=48

# UI lifecycle-уведомлений
LIFECYCLE_VIDEO_GUIDE_URL=https://viedo.com/video
LIFECYCLE_SUPPORT_CONTACT=https://t.me/examplechannel


# URL кнопки «Канал» в боте (classic — всегда при непустом URL; minimalism — при CABINET_TELEGRAM_SHOW_CHANNEL_BUTTON=true).
# Можно менять в админке (Ссылки в боте).
CHANNEL_URL=https://t.me/examplechannel
TOS_URL=
SERVER_SELECTION_URL=https://t.me/examplechannel
# Юридические ссылки («Помощь» в боте + site_links кабинета).
# Gate «Принимаю/Отказываюсь» в боте — только если заданы ОБА PUBLIC_OFFER_URL и PRIVACY_POLICY_URL.
# TERMS_OF_SERVICE_URL — опциональная кнопка в gate; в кабинете приоритет для ссылки «соглашения».
PUBLIC_OFFER_URL=https://t.me/examplechannel
PRIVACY_POLICY_URL=https://t.me/examplechannel
TERMS_OF_SERVICE_URL=https://t.me/examplechannel
VIDEO_GUIDE_URL=https://t.me/video



# =============================================================================
# Web-кабинет (подробнее в documentation/cabinet/SETUP-GUIDE-RU.md)
# =============================================================================
# Главный переключатель кабинета. Если false — бот работает как раньше, cabinet API не поднимается.
CABINET_ENABLED=false
# Access-лог HTTP кабинета в stdout бота: minimal (по умолчанию) — только 4xx/5xx и медленные на INFO, остальное DEBUG;
# full — каждый запрос INFO (шумно в Docker); off — без строк cabinet http.
# minimal - только 4xx/5xx и медленные на INFO, остальное DEBUG;
# off - без логирования;
 CABINET_HTTP_ACCESS_LOG=minimal
# Включает блок self-delete в профиле (ставьте true только на dev для возможности удалять аккаунты на стр профиля кабинета)
# В продакшене рекомендуется оставить false
CABINET_PROFILE_DELETE_ENABLED=false

# Публичный URL кабинета (для return_url YooKassa, ссылок в письмах и т.п.)
CABINET_PUBLIC_URL=https://cabinet.example.com

# Название и логотип в шапке SPA и в футере страниц входа (по умолчанию Cabinet + иконка щита).
CABINET_BRAND_NAME=Мой VPN

# Картинка: полный URL (https://...), путь с ведущим / или относительный к CABINET_PUBLIC_URL (например brand/logo.png).
# CABINET_BRAND_LOGO_URL=https://example.com/logo.png

# Либо файл на диске процесса бота; отдаётся как GET .../cabinet/api/public/brand-logo (и как favicon во вкладке).
# Относительный путь ищется: рядом с бинарником, затем cwd, затем CABINET_BRAND_LOGO_FILE_BASE (если задан).
# В Docker при WORKDIR=/ положите файл рядом с бинарём или укажите CABINET_BRAND_LOGO_FILE_BASE=/app
CABINET_BRAND_LOGO_FILE=./vpn_cat.png

# CABINET_BRAND_LOGO_FILE_BASE=/app
# Если заданы и URL, и файл — используется CABINET_BRAND_LOGO_URL.

# PWA (установка web-приложения на мобильные устройства)
# Включает install-prompt на фронте и runtime manifest по адресу:
# /cabinet/api/public/pwa-manifest.webmanifest
CABINET_PWA_ENABLED=false
# CABINET_PWA_APP_NAME=MEOWS VPN
# CABINET_PWA_SHORT_NAME=MEOWS

# Светлая тема в web-кабинете (переключатель в шапке). false — только тёмная тема для всех.
# Можно менять в админке без перезапуска (Оформление кабинета).
CABINET_LIGHT_THEME_ENABLED=true

# Декоративная тема кабинета для всех пользователей (порядок = цветовые группы):
# off | green | spring | cyber | neon | ocean | new_year | slate
# | aurora | violet | lavender | pink | valentine
# | sunset | orange | halloween | yellow | summer | black_friday
CABINET_DECOR_THEME=off

# Витрина тарифов кабинета (режим tariffs): monthly — помесячная цена; marketing — ₽/мес при оплате за 12 мес + сноска.
# Можно менять в админке без перезапуска (Настройки бота → Тарифы).
CABINET_TARIFF_PRICE_DISPLAY=monthly

# Шифрование deep link подключения (страница «Установка» кабинета). Можно менять в админке
# без перезапуска (Настройки бота → Оформление кабинета → Deep link подключения).
# true — при подключении Happ отдаётся зашифрованная ссылка happ://crypt5/ вместо happ://add/:
#   подписку нельзя смотреть/редактировать/шарить в приложении. ВНИМАНИЕ: ссылка подписки
#   отправляется на сторонний сервис crypto.happ.su (официальный API Happ).
CABINET_DEEPLINK_HAPP_ENCRYPT=false
# true — при подключении INCY отдаётся обфусцированная ссылка incy://crypt1/ вместо incy://add/:
#   скрывает адрес подписки от сканеров чатов/скриншотов. Шифрование выполняется локально
#   (ключ INCY публичный, зашит в клиенты) — это обфускация, а не полная защита секретности.
CABINET_DEEPLINK_INCY_ENCRYPT=false

# URL для Telegram WebApp: кнопки «Мой VPN» и «Подключить VPN» в боте при CABINET_ENABLED=true.
# Если пусто — собирается как CABINET_PUBLIC_URL + CABINET_MINI_APP_PATH (ниже).
# CABINET_MINI_APP_URL=https://cabinet.example.com/cabinet/
# Путь SPA относительно CABINET_PUBLIC_URL (по умолчанию /cabinet/ — см. internal/cabinet/http/router.go).
# CABINET_MINI_APP_PATH=/cabinet/

# Главное меню бота при CABINET_ENABLED=true: classic (полный набор кнопок) | minimalism (WebApp + короткий текст).
# Если не задано — classic.
CABINET_TELEGRAM_UI_MODE=classic

# Опциональные URL-кнопки внизу меню бота при CABINET_TELEGRAM_UI_MODE=minimalism.
# Можно менять в админке без перезапуска (Оформление кабинета → Кнопки в Telegram).
# Ссылки: CHANNEL_URL / FEEDBACK_URL. Текст, custom emoji (emoji_id) и цвет (style) —
# в translations/* → cabinet_minimal_btn_channel / cabinet_minimal_btn_feedback.
# Одна включённая — 1 кнопка в ряд; обе — 2 в ряд.
CABINET_TELEGRAM_SHOW_CHANNEL_BUTTON=false
CABINET_TELEGRAM_SHOW_FEEDBACK_BUTTON=false

# Разрешённые origin'ы для CORS, через запятую. Обычно совпадает с CABINET_PUBLIC_URL.
CABINET_ALLOWED_ORIGINS=https://cabinet.example.com

# Секрет для подписи access-JWT кабинета. >= 32 байт. Сгенерировать: openssl rand -hex 32
CABINET_JWT_SECRET=

# Домен для refresh-cookie. Если пусто — берётся хост из CABINET_PUBLIC_URL.
CABINET_COOKIE_DOMAIN=

# TTL токенов
CABINET_ACCESS_TTL_MINUTES=15
CABINET_REFRESH_TTL_DAYS=30

# База для synthetic customer.telegram_id у web-only клиентов 
# Должна быть ВЫШЕ любых реальных Telegram id, но умещаться в int64.
# Временный(мб вечный) костыль, чтобы не переделывать весь код бота под кабинет реализацию. 
CABINET_WEB_TELEGRAM_ID_BASE=7000000000000000000

# SMTP (для подтверждения email, сброса пароля; если пусто — email-функции отключены)
#БЕЗ НИХ НЕ БУДЕТ РАБОТАТЬ EMAIL регистрация/сброс пароля так-как туда приходит код пароль
CABINET_SMTP_HOST=smtp.beget.com
CABINET_SMTP_PORT=465
CABINET_SMTP_USER=noreply@domen.com
CABINET_SMTP_PASSWORD=
CABINET_SMTP_TLS=true
CABINET_MAIL_FROM="VPN <noreply@domen.com>"

# Google OAuth (опционально)
CABINET_GOOGLE_CLIENT_ID=
CABINET_GOOGLE_CLIENT_SECRET=
CABINET_GOOGLE_REDIRECT_URL=https://cabinet.domen.com/cabinet/api/auth/google/callback
# Yandex OAuth (опционально)
CABINET_YANDEX_CLIENT_ID=
CABINET_YANDEX_CLIENT_SECRET=
CABINET_YANDEX_REDIRECT_URL=https://cabinet.domen.com/cabinet/api/auth/yandex/callback
# VK ID OAuth 2.1 (id.vk.ru)
CABINET_VK_CLIENT_ID=
CABINET_VK_CLIENT_SECRET=
CABINET_VK_CLIENT_REDIRECT_URL=https://cabinet.domen.com/cabinet/api/auth/vk/callback

# Telegram web auth mode:
# - oidc   : только Telegram OAuth 2.0 (рекомендуется)
# - widget : только Telegram Login Widget 1.0
CABINET_TELEGRAM_WEB_AUTH_MODE=widget
# Telegram Login Widget: username бота (без @), который будет логинить пользователей.
# Обязателен только для CABINET_TELEGRAM_WEB_AUTH_MODE=widget.
CABINET_TELEGRAM_LOGIN_BOT_USERNAME=
# Токен того же бота (из BotFather), что и username выше — для проверки HMAC виджета/miniapp.
# Если пусто — берётся TELEGRAM_TOKEN (тогда виджет должен быть от того же бота).
CABINET_TELEGRAM_LOGIN_BOT_TOKEN=
# Telegram OAuth 2.0 (OIDC) для web-логина/регистрации/привязки Telegram в кабинете.
# Mini App вход в Telegram-клиенте остаётся через source=miniapp + init_data.
# Redirect URL должен быть добавлен в BotFather/Telegram Login 2.0 и обычно равен:
# https://<ваш-домен-кабинета>/cabinet/api/auth/telegram/callback
CABINET_TELEGRAM_OIDC_CLIENT_ID=
CABINET_TELEGRAM_OIDC_CLIENT_SECRET=
# Если пусто и задан CABINET_TELEGRAM_OIDC_CLIENT_ID — по умолчанию собирается из CABINET_PUBLIC_URL:
# <CABINET_PUBLIC_URL>/cabinet/api/auth/telegram/callback
CABINET_TELEGRAM_OIDC_REDIRECT_URL=https://cabinet.domen.com/cabinet/api/auth/telegram/callback

# Cloudflare Turnstile (опционально, бесплатная альтернатива reCAPTCHA)
CABINET_TURNSTILE_ENABLED=false
CABINET_TURNSTILE_SITE_KEY=
CABINET_TURNSTILE_SECRET_KEY=

# Prometheus: GET /cabinet/api/metrics. Оба пусты — без Basic-auth (защищайте на reverse-proxy).
CABINET_METRICS_USER=
CABINET_METRICS_PASSWORD=

# -----------------------------------------------------------------------------
# Колесо фортуны (кабинет)
# -----------------------------------------------------------------------------
# false — API колеса отключён; в меню кабинета пункт скрыт (страница /fortune по прямой ссылке остаётся).
FORTUNE_ENABLED=false
# Максимум платных спинов за UTC-сутки (бесплатный FORTUNE_DAILY_FREE_SPIN в счёт не входит).
FORTUNE_MAX_SPINS_PER_DAY=4
FORTUNE_MIN_SUBSCRIPTION_DAYS=2
FORTUNE_SPIN_COST_DAYS=1
# Один бесплатный спин за UTC-сутки
FORTUNE_DAILY_FREE_SPIN=true
#Вкл/выкл бегущую строку и блок на странице
FORTUNE_WINNER_TICKER_ENABLED=true
# true — в ленту только фейк (имена/призы/время не старше 24 ч), без строк из БД; редко подмешивается фейк +180 дн. false — реальные спины + витрина ≈85% дней / ≈15% прочих.
FORTUNE_WINNER_TICKER_FAKE_FILL=false

#Веса секторов (относительные, только целые >= 0; P = weight / сумма весов; 0 = не в RNG).
#Ниже сумма = 1000: +3 дн. 5%, +5 дн. 2.5%, +7 дн. 2%, +15 дн. 1%, +30 дн. 0.5%; остальное — micro/xp/скидки. DAYS_180=0 — только UI
FORTUNE_WEIGHT_MICRO=488
FORTUNE_WEIGHT_XP=355
FORTUNE_WEIGHT_DISCOUNT_3=60
FORTUNE_WEIGHT_DAYS_3=25
FORTUNE_WEIGHT_DISCOUNT_5=40
FORTUNE_WEIGHT_DAYS_5=15
FORTUNE_WEIGHT_DAYS_7=10
FORTUNE_WEIGHT_DAYS_15=5
FORTUNE_WEIGHT_DAYS_30=2
FORTUNE_WEIGHT_DAYS_180=0

#Величины призов (не веса):
FORTUNE_REWARD_XP_AMOUNT=35
FORTUNE_REWARD_MICRO_XP_MIN=5
FORTUNE_REWARD_MICRO_XP_MAX=15
FORTUNE_REWARD_DISCOUNT_3_PERCENT=3
FORTUNE_REWARD_DISCOUNT_5_PERCENT=5
FORTUNE_REWARD_DAYS_3=3
FORTUNE_REWARD_DAYS_5=5
FORTUNE_REWARD_DAYS_7=7
FORTUNE_REWARD_DAYS_15=15
FORTUNE_REWARD_DAYS_30=30
FORTUNE_REWARD_DAYS_180=180



